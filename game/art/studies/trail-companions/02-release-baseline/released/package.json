{
  "name": "forest-trail",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test:proving": "tsx tools/proving.ts scout && tsx tools/proving.ts toyota && tsx tools/proving.ts ranger",
    "test:lap": "tsx tools/sim-test.ts lap",
    "test:drive": "tsx tools/sim-test.ts basic && tsx tools/sim-test.ts mud && tsx tools/sim-test.ts rock",
    "map": "tsx tools/map-preview.ts docs/map-preview.png",
    "assets": "blender --background --python art/blender/build_all.py"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "playcanvas": "^2.22.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^8.3.1"
  }
}
